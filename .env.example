# LexPilot — Environment Variables
# Copy this file to .env and fill in values before running docker-compose up

# -------------------------------------------------------------------
# Backend — lexpilot-app
# -------------------------------------------------------------------

# Static API key for gateway auth (dev placeholder — use secrets manager in prod)
LEXPILOT_API_KEY=dev-api-key-change-me

# Enable API key auth + rate limiting (true in Docker Compose by default, false for local dev)
LEXPILOT_SECURITY_ENABLED=false

# LLM provider credentials
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1

# Postgres password
POSTGRES_PASSWORD=lexpilot_dev

# -------------------------------------------------------------------
# Frontend — Next.js
# -------------------------------------------------------------------

# Server-side backend URL and API key used by Next.js BFF proxy (/api/backend)
INTERNAL_API_URL=http://localhost:8080/api/v1
LEXPILOT_API_KEY=dev-api-key-change-me

